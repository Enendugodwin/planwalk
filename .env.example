# Optional: provide Firebase web-app configuration at build time.
# Copy to .env.local and fill in values from the Firebase console.
# Firebase AI Logic must be enabled and App Check enforced in the console.
# For localhost, keep debugAppCheck true and register the token shown in AI settings.
# For production, remove debugAppCheck and supply recaptchaSiteKey instead.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"...","storageBucket":"...","messagingSenderId":"...","debugAppCheck":true}
# Optional: leave blank to use the app default (gemini-4-hydrogen), or set a
# model enabled for your Firebase project.
VITE_FIREBASE_CLOUD_MODEL=
